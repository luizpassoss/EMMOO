# Ambiente de execução
NODE_ENV=development
PORT=3333
# Fuso usado para saber qual é o dia de "hoje" na escola
TZ=America/Sao_Paulo

# Persistência: "memory" (padrão, roda sem instalar banco) ou "mysql" (Prisma + MySQL)
DB_DRIVER=memory
DATABASE_URL=mysql://emmoo:emmoo@localhost:3306/emmoo

# Autenticação (troque o segredo em produção)
JWT_SECRET=dev-secret-altere-em-producao
JWT_EXPIRES_IN=8h

# Cadastro público de escolas novas (multi-tenant): "aberto" ou "fechado".
# Sem a variável: aberto em desenvolvimento, fechado em produção.
CADASTRO_ESCOLAS=aberto

# Origem(ns) do front-end autorizada(s) no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Endereço do front, usado nos links enviados por e-mail ("esqueci minha senha").
# Sem a variável: a primeira origem de CORS_ORIGIN.
APP_URL=http://localhost:5173

# A API está atrás de um proxy (o do Vite em desenvolvimento, nginx, túnel)? Então o endereço (IP) de quem acessa vem
# do X-Forwarded-For — é ele que entra no limite de tentativas de login (5 senhas erradas por conta e 30 por endereço,
# em 15 minutos). Valores: "loopback" (proxy na mesma máquina), "loopback, uniquelocal" (proxy na rede interna),
# o número de proxies na frente (ex.: 1) ou false (padrão: acesso direto, sem proxy).
TRUST_PROXY=loopback

# Rotinas automáticas (RF10/RF12): gera as mensalidades do mês e processa os alertas de pagamento,
# ao iniciar e a cada hora. "ligadas" (padrão) ou "desligadas" (nos testes, já ficam desligadas).
ROTINAS=ligadas

# E-mail dos alertas de vencimento e atraso (RF12) e do "esqueci minha senha". Sem SMTP_URL, os alertas ficam
# registrados como pendentes e aparecem na tela de mensalidades, e a senha esquecida é redefinida pela coordenação;
# com ele, os alertas vão ao responsável e cada pessoa recupera a própria senha por um link no e-mail.
# Ex.: SMTP_URL=smtps://usuario:senha@smtp.servidor.com:465
SMTP_URL=
EMAIL_REMETENTE=EMMOO <nao-responda@emmoo.app>

