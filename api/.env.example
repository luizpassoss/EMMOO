# Ambiente de execução
NODE_ENV=development
PORT=3333
# Fuso usado para saber qual é o dia de "hoje" na escola
TZ=America/Sao_Paulo

# Persistência: "memory" (padrão, roda sem instalar banco) ou "mysql" (Prisma + MySQL)
DB_DRIVER=memory
DATABASE_URL=mysql://emmoo:emmoo@localhost:3306/emmoo

# Autenticação (troque o segredo em produção)
JWT_SECRET=dev-secret-altere-em-producao
JWT_EXPIRES_IN=8h

# Origem(ns) do front-end autorizada(s) no CORS, separadas por vírgula
CORS_ORIGIN=http://localhost:5173
