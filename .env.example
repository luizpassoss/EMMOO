# Configuração do docker-compose (produção ou teste completo com Docker). Copie para ".env", nesta mesma pasta.
# O .env nunca vai para o Git. Para gerar um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# Segredo das sessões (obrigatório): aleatório, com 32 caracteres ou mais.
JWT_SECRET=

# Senhas do MySQL (obrigatórias). Use só letras, números, "-" e "_" (a senha do app entra no endereço do banco).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Endereço público do sistema (links dos e-mails). Com https, o navegador passa a exigir https.
APP_URL=http://localhost:8080

# Porta do computador onde o sistema responde.
PORTA=8080

# Cadastro público de escolas novas: "fechado" (padrão) ou "aberto".
CADASTRO_ESCOLAS=fechado

# E-mail dos alertas de pagamento e do "esqueci minha senha" (opcional). Ex.: smtps://usuario:senha@smtp.servidor.com:465
SMTP_URL=
EMAIL_REMETENTE=EMMOO <nao-responda@escola.com.br>

# Quantos proxies há na frente do app: 1 (o Nginx deste compose). Com outro na frente (ex.: CloudFront), 2.
TRUST_PROXY=1

# "sim" cria a escola de demonstração (código emmoo, senhas públicas do README). Nunca em produção.
DADOS_DEMO=nao
