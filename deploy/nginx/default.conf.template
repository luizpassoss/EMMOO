# Nginx como proxy reverso (RFC, seção 5.4): recebe o tráfego — do CloudFront, na AWS; do navegador, no compose
# local — e o repassa ao contêiner do EMMOO, que entrega a API e o front. Ao iniciar, a imagem oficial do Nginx
# preenche o segredo abaixo com a variável de ambiente ORIGEM_SEGREDO.
server {
  listen 80;
  server_name _;
  server_tokens off;
  client_max_body_size 1m;

  # Na AWS, o firewall só deixa entrar o CloudFront — mas de qualquer distribuição, de qualquer pessoa. Só a do
  # EMMOO envia este cabeçalho secreto. Sem segredo configurado (compose local), nada é exigido.
  if ($http_x_origem_emmoo != "${ORIGEM_SEGREDO}") {
    return 403;
  }

  location / {
    proxy_pass http://app:3333;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Origem-Emmoo ""; # o segredo para aqui: não segue para a aplicação
    proxy_read_timeout 60s;
  }
}
